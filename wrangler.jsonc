{
  "name": "nexa-model",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-06",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "PUBLIC_SITE_URL": "https://nexa-model.com",
    "IMAGEKIT_URL_ENDPOINT": "https://ik.imagekit.io/4wqtbbxlw",
    "IMAGEKIT_PUBLIC_KEY": "public_JoigL0BTKplQWvruBFu3esYJiuU="
  },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },

  "ratelimits": [
    {
      "name": "APPLY_RATE_LIMITER",
      "namespace_id": "31002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "31003",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexa-production",
      "database_id": "cd6a3fa4-c801-4ee5-8ca7-103b11509908"
    }
  ]
}
