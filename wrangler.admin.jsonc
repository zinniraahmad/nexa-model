{
  "name": "nexa-model-admin",
  "main": "./admin/worker.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "onlyadmin.nexa-model.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist-admin",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/admin/*"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "mute-shape-c1b3.cloudflareaccess.com",
    "ACCESS_AUD": "037437dc99388742064478449072b915bc3b19d0c2d327646e01d20c2bce3bc1",
    "ADMIN_EMAILS": "itszinniraahmad@gmail.com",
    "PUBLIC_SITE_URL": "https://nexa-model.com",
    "IMAGEKIT_URL_ENDPOINT": "https://ik.imagekit.io/4wqtbbxlw"
  },
  "ratelimits": [
    {
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "31004",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "ADMIN_MUTATION_RATE_LIMITER",
      "namespace_id": "31005",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexa-production",
      "database_id": "cd6a3fa4-c801-4ee5-8ca7-103b11509908"
    }
  ]
}
